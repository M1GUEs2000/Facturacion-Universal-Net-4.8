<?xml version="1.0" encoding="utf-8"?>
<!-- Plantilla. Copiar a secrets.config (gitignored) y completar con valores reales.
     Cargado por Web.config vía appSettings file="secrets.config". -->
<appSettings>
  <add key="ConnectionString" value="Data Source=SERVIDOR\INSTANCIA;Initial Catalog=FacturacionCore;User ID=usuario;Password=clave;MultipleActiveResultSets=True;TrustServerCertificate=True" />
  <!-- JwtSecret: mínimo 32 bytes aleatorios para HMAC-SHA256 -->
  <add key="JwtSecret" value="GENERAR-SECRETO-ALEATORIO-LARGO" />
  <!-- CertEncryptionKey: 32 bytes aleatorios en base64 (AES-256-CBC + HMAC del cert_password) -->
  <add key="CertEncryptionKey" value="GENERAR-32-BYTES-BASE64" />
  <!-- AuthClients: credenciales que pueden pedir un JWT en POST /api/v1/auth/token.
       Formato "cliente:secret" separados por ";". El secret debe ser largo y aleatorio.
       Sin esta clave, NINGÚN cliente puede obtener token (falla cerrada). -->
  <add key="AuthClients" value="cliente1:GENERAR-SECRET-LARGO-ALEATORIO" />
  <!-- SMTP (envío de correo de facturas). Sin SmtpHost/SmtpRemitente el servicio queda
       "no configurado" y no envía. SmtpUsuario/SmtpPassword son las credenciales del buzón. -->
  <add key="SmtpHost" value="smtp.tuproveedor.com" />
  <add key="SmtpPort" value="587" />
  <add key="SmtpSsl" value="true" />
  <add key="SmtpUsuario" value="facturacion@tuempresa.com" />
  <add key="SmtpPassword" value="CLAVE-DEL-BUZON" />
  <add key="SmtpRemitente" value="facturacion@tuempresa.com" />
  <add key="SmtpNombreRemitente" value="Facturación Electrónica" />
</appSettings>
